<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="PokeScan" android:textColor="#FFCB05" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#EEF0F4" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_cards" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#8B92A3" android:textSize="12sp" />
    <TextView android:id="@+id/w_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#8B92A3" android:textSize="12sp" android:maxLines="2" />
</LinearLayout>
